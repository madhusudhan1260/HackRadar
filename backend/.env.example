# Copy to .env and adjust. Every value here has a working default.

# --- Database ---------------------------------------------------------
# SQLite (default, zero setup). Switch to Postgres for production:
# DATABASE_URL=postgresql+psycopg://hackradar:hackradar@localhost:5432/hackradar
# DATABASE_URL=sqlite:///./hackradar.db

# --- Collectors -------------------------------------------------------
# 'unstop' is deliberately excluded: no public API and restrictive ToS.
ENABLED_COLLECTORS=seed,devpost,mlh
INGEST_INTERVAL_MINUTES=360
RUN_SCHEDULER=true
HTTP_TIMEOUT=20

# --- Frontend ---------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email notifications (optional) -----------------------------------
# For Gmail use an App Password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com

# --- Telegram notifications (optional) --------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- LLM enrichment (optional) ----------------------------------------
# Without this the rule-based classifier is used, which works fine.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
