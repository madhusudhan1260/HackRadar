# Copy to .env and adjust. Every value here has a working default.

# --- Database ---------------------------------------------------------
# SQLite (default, zero setup). Switch to Postgres for production:
# DATABASE_URL=postgresql+psycopg://hackradar:hackradar@localhost:5432/hackradar
# DATABASE_URL=sqlite:///./hackradar.db

# --- Collectors -------------------------------------------------------
# Real sources only. 'seed' is bundled sample data whose links point at
# example.com — useful for offline development and tests, never for a live
# site. 'unstop' is excluded: no public API and restrictive ToS.
ENABLED_COLLECTORS=devpost,mlh
INGEST_INTERVAL_MINUTES=360
RUN_SCHEDULER=true
HTTP_TIMEOUT=20

# --- Frontend ---------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth --------------------------------------------------------------
# CHANGE THIS before deploying. Rotating it invalidates all sessions + OTPs.
SECRET_KEY=dev-secret-change-me-in-production
SESSION_TTL_HOURS=168
MIN_PASSWORD_LENGTH=8

# --- OTP ---------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_LIMIT=5

# --- Verification codes -------------------------------------------------
# Codes are EMAILED, not texted: email costs nothing, has no per-country
# regulatory hurdle, and reaches anyone. With no SMTP settings the code is
# printed to the backend log so development still works.
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it below (16 chars,
# NOT your normal Google password). Free, ~500 messages/day.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=you@gmail.com

# --- SMS delivery (unused for codes; kept for future notifications) ------
# console = OTP printed to the backend log (development, no account needed).
# twilio  = real SMS worldwide.
# msg91   = real SMS, usually cheaper for Indian numbers (needs DLT template).
SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91

# Twilio — from https://console.twilio.com
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# MSG91 — from https://control.msg91.com
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=HCKRDR
# MSG91_TEMPLATE_ID=

# --- Email notifications (optional) -----------------------------------
# For Gmail use an App Password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com

# --- Telegram notifications (optional) --------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- LLM enrichment (optional) ----------------------------------------
# Without this the rule-based classifier is used, which works fine.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
